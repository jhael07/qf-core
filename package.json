{
  "name": "@qf/core",
  "version": "0.0.1",
  "description": "Type-safe, chainable query builder for composing validated filter expressions with nested paths, grouping, and ordering.",
  "homepage": "https://github.com/jhael07/qf-core#readme",
  "bugs": {
    "url": "https://github.com/jhael07/qf-core/issues"
  },
  "license": "MIT",
  "author": "Jhael Rodriguez <jhaelrodriguez.331@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhael07/qf-core.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "exec": "node dist/index.mjs",
    "prepublishOnly": "vp run build",
    "release": "standard-release",
    "prepare": "vp config"
  },
  "dependencies": {
    "standard-version": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  }
}
